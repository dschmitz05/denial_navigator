# ─────────────────────────────────────────────
# OpenClaim Navigator — Environment Configuration
# ─────────────────────────────────────────────

# Database
POSTGRES_USER=denial_nav
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=denial_navigator

# LLM Settings
LLAMA_BASE_URL=http://10.10.10.98:8080
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
# Task prefixes default from the model (nomic: "search_query: " /
# "search_document: "). Override only for a model with different ones; unset
# or empty keeps the default, "none" disables. Changing either requires
# re-embedding stored chunks.
# EMBED_QUERY_PREFIX=
# EMBED_DOCUMENT_PREFIX=
# The embedding server. llama.cpp's chat endpoint answers /v1/embeddings with
# 501, so this is a separate server running an embedding model (768 dims).
EMBED_BASE_URL=http://10.10.10.98:8081
# Set false to use lexical-only knowledge indexing and search. This avoids
# calls to the embedding provider while retaining full-text retrieval.
VECTOR_SEARCH_ENABLED=true
# The retrieval evidence cut, calibrated with scripts/eval_retrieval.py. A
# chunk must clear MIN_SIMILARITY, sit within RELATIVE_CUT of the best match,
# and contain one of the query's own terms as a whole word (see
# docs/ARCHITECTURE.md); when nothing survives, the analysis records
# no_evidence rather than citing weak matches.
# MIN_SIMILARITY=0.62
# RELATIVE_CUT=0.04
# ANCHOR_MAX_SHARE=0.25

# Downstream RAG/LLM requests use bounded retries and a circuit breaker. Once
# the breaker opens, recommendations immediately use deterministic fallback.
UPSTREAM_MAX_RETRIES=2
UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=3
UPSTREAM_CIRCUIT_COOLDOWN_SECS=30
RAG_REQUEST_TIMEOUT_SECS=30
LLM_REQUEST_TIMEOUT_SECS=180

# Optional local Keycloak profile for OIDC development/testing only:
# docker compose -f docker-compose.rust.yml --profile oidc up -d keycloak
# OIDC validator configuration will use the realm discovery/JWKS endpoints.
# Set both before enabling the profile; do not use placeholders in a shared
# environment.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Enable external OIDC access-token validation by setting the provider's
# UserInfo endpoint (HTTPS outside local development). Map its immutable `sub`
# claim to users.oidc_subject before the user can access application data.
# OIDC_USERINFO_URL=https://idp.example.com/realms/denial-navigator/protocol/openid-connect/userinfo

# Service URLs
EDIPARSER_SERVICE_URL=http://localhost:8001
RAG_ENGINE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003

# The maximum identifying information permitted in AI prompts: `limited`
# (default), `none`, or `full`. Use `full` only with an approved provider.
AI_PHI_DISCLOSURE_LEVEL=limited

# CORS
CORS_ORIGINS=http://localhost:3081,http://localhost:5173

# Dropzone (EDI file input directory)
DROPZONE_PATH=/path/to/edi/dropzone
INGESTION_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Optional SFTP EDI source. Keep SFTP_ENABLED=false unless all required
# connection settings are present. Pin the server host key using the SHA-256
# fingerprint reported by the partner (for example: SHA256:base64-value).
# Prefer a read-only, unencrypted private key mounted into the container; use
# SFTP_PASSWORD only when the partner cannot support key-based authentication.
SFTP_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_REMOTE_PATH=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSWORD=
SFTP_HOST_PUBLIC_KEY_SHA256=
SFTP_POLL_SECONDS=60

# Optional S3-compatible EDI source. Use a separate read-only credential
# scoped to the import bucket/prefix; this is independent of knowledge-source
# artifact storage. Polling safely handles S3 ListObjectsV2 pagination.
S3_IMPORT_ENABLED=false
S3_IMPORT_ENDPOINT=
S3_IMPORT_BUCKET=
S3_IMPORT_REGION=us-east-1
S3_IMPORT_ACCESS_KEY_ID=
S3_IMPORT_SECRET_ACCESS_KEY=
S3_IMPORT_PREFIX=
S3_IMPORT_POLL_SECONDS=60

# Logging
LOG_LEVEL=info

# JWT / Auth (for future RBAC implementation)
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Generate each credential independently with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Scoped callback credentials are accepted only for each service's one API route.
EDIPARSER_SERVICE_API_KEY=change_me_in_production
LLM_SERVICE_API_KEY=change_me_in_production
# Gateway-to-service credentials protect the private parser, RAG, and LLM APIs.
EDIPARSER_INTERNAL_API_KEY=change_me_in_production
RAG_INTERNAL_API_KEY=change_me_in_production
LLM_INTERNAL_API_KEY=change_me_in_production

# Optional MinIO profile (`docker compose --profile object-storage ...`).
# Generate strong, distinct credentials before enabling it.
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password

# Local source artifacts for uploaded knowledge documents. Put this on an
# encrypted volume with access limited to the application service account.
OBJECT_STORAGE_LOCAL_PATH=./data/objects

# Object storage backend: `local` (default) or `s3`. The S3 mode uses
# path-style AWS Signature V4 requests and is compatible with MinIO.
OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_S3_ENDPOINT=http://minio:9000
# OBJECT_STORAGE_S3_BUCKET=denial-artifacts
# OBJECT_STORAGE_S3_REGION=us-east-1
# OBJECT_STORAGE_S3_ACCESS_KEY_ID=replace_me
# OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=replace_me
# For local MinIO, create `denial-artifacts` in the console at
# http://localhost:19001, then run Compose with `--profile object-storage`.

# ─────────────────────────────────────────────
# TLS
# ─────────────────────────────────────────────
# self-signed : generate a certificate if none is mounted (default).
#               Encrypted but not authenticated - browsers warn. Replace it
#               before go-live.
# provided    : use certs/tls.crt + certs/tls.key; refuse to start without.
# off         : plain HTTP only. Valid ONLY when something else terminates TLS
#               over a trusted hop. Across a network this exposes PHI.
TLS_MODE=self-signed

# The hostname staff will actually type. A certificate issued for the wrong
# name makes the browser warning worse, not better.
TLS_HOSTNAME=localhost

# Host port 443 is published on. Used only to build the HTTP->HTTPS redirect.
PUBLIC_HTTPS_PORT=3443

# ─────────────────────────────────────────────
# Two-factor authentication (TOTP)
# ─────────────────────────────────────────────
# The name shown in the user's authenticator app.
TOTP_ISSUER=OpenClaim Navigator

# Exact 32-byte Fernet key, base64url-encoded. Generate with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOTP_FERNET_KEY=change_me_in_production

# ─────────────────────────────────────────────
# Retention & backups
# ─────────────────────────────────────────────
# How long audit entries are kept before a prune will remove them. 2190 days
# is six years, the usual HIPAA documentation retention figure. Nothing is
# deleted automatically; this only sets what a deliberate prune considers old.
AUDIT_RETENTION_DAYS=2190

# How many nightly database dumps scripts/backup.sh keeps.
BACKUP_RETAIN_DAYS=30

# How far ahead a deadline digest looks. Matches the dashboard's priority
# window by default, so the two never disagree about the same denial.
DEADLINE_DIGEST_DAYS=14
