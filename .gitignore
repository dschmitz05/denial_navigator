# Parsed EDI output contains claim and patient data. The directory itself is a
# bind mount that must exist, so keep it and ignore its contents.
ediparser/output/
# (Docker recreates this bind mount on `docker compose up`.)

# Database dumps contain claims and denials, including patient names and dates
# of birth. Never commit these.
database/backups/

