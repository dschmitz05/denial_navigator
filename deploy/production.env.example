# Copy to deploy/production.env, set mode 0600, and replace every value.
# Do not commit deploy/production.env.
POSTGRES_USER=openclaim
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password
POSTGRES_DB=openclaim
INIT_ADMIN_PASSWORD=replace_with_a_long_one_time_admin_password

JWT_SECRET=replace_with_a_long_random_value
EDIPARSER_SERVICE_API_KEY=replace_with_a_long_random_value
LLM_SERVICE_API_KEY=replace_with_a_long_random_value
EDIPARSER_INTERNAL_API_KEY=replace_with_a_long_random_value
RAG_INTERNAL_API_KEY=replace_with_a_long_random_value
LLM_INTERNAL_API_KEY=replace_with_a_long_random_value
TOTP_FERNET_KEY=replace_with_a_32_byte_base64url_fernet_key

# Must exactly match the staff-facing browser origin.
TLS_HOSTNAME=claims.example.org
CORS_ORIGINS_RUST=https://claims.example.org

# Keep the following unset unless their associated optional source is enabled.
SFTP_ENABLED=false
S3_IMPORT_ENABLED=false
